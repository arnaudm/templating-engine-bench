{#accounts}
<div>
  {@eq key=.status value="closed"}
  <div>
      Your account has been closed!
  </div>
  {/eq}
  {@eq key=.status value="suspended"}
  <div>
      Your account has been temporarily suspended
  </div>
  {/eq}
  {@eq key=.status value="open"}
  <div>
      Bank balance:
      <span class="{@lt key=.balance value=0}negative{:else}positive{/lt}">{.balanceFormatted}</span>
  </div>
  {/eq}
</div>
{/accounts}