<!DOCTYPE html>
<html>
  <head>
    <title>{{=it.title}}</title>
  </head>
  <body>
    <p>{{!it.text}}</p>
    {{? it.projects.length > 0}}
      {{~it.projects :project}}
        <a href="{{=project.url}}">{{!project.name}}</a>
        <p>{{=project.description}}</p>
      {{~}}
    {{??}}
      <p>No projects</p>
    {{?}}
  </body>
</html>