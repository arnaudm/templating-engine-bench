<html>
  <head>
    <title>{{it.title}}</title>
  </head>
  <body>
    <p>{{it.text}}</p>
    {{@if(it.projects && it.projects.length > 0)}}
      {{@each(it.projects) => project}}
        <a href="{{project.url}}">{{project.name}}</a>
        <p>{{project.description}}</p>
      {{/each}}
    {{#else}}
      No projects
    {{/if}}
  </body>
</html>
